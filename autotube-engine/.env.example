GEMINI_API_KEY=
# Opcional: fallback de generación de guion si Gemini agota reintentos (rate limit, timeout, 5xx).
GROQ_API_KEY=
PEXELS_API_KEY=
EDGE_TTS_VOICE=es-ES-AlvaroNeural

REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL (pgvector). docker compose up -d desde autotube-engine/
DATABASE_URL=postgresql://autotube:autotube@localhost:5432/autotube

# API HTTP para el Dashboard (npm run api)
ENGINE_PORT=3001
DASHBOARD_ORIGIN=http://localhost:3000
OPERATOR_NAME=operator

# Tema base para la generación diaria automática (CRON 1). Interino hasta que
# Fase 3 reemplace esto por un backlog de temas gestionado desde el Dashboard.
NICHE_TOPIC=curiosidades del espacio
DAILY_CRON_SCHEDULE=0 9 * * *

ANTI_REPETITION_MAX_ATTEMPTS=3
ANTI_REPETITION_THRESHOLD=0.85
ANTI_REPETITION_HISTORY_WINDOW=20

# autopilot = flujo libre (default). directed = 30s / hook-CTA. El worker ignora esto y usa autopilot.
NARRATIVE_PROFILE=autopilot

# YouTube Data API v3 (npm run youtube:auth, luego pegar el refresh token).
# No commitear .env. Cliente OAuth Desktop; redirect http://127.0.0.1:53682/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CATEGORY_ID=22
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true
YOUTUBE_CHANNEL_ID=

# CRON 2: snapshots de YouTube Analytics (worker). Default cada 6 h.
ANALYTICS_CRON_SCHEDULE=0 */6 * * *

# Proveedores. Default $0 (Edge-TTS + Pexels/local). No commitear secretos.
TTS_PROVIDER=edge-tts
IDENTITY_VISUAL_PROVIDER=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
FAL_KEY=
FAL_IDENTITY_MODEL=https://fal.run/fal-ai/flux/schnell

# 0 = sin tope. PAID_ON_CAP=zero cae a Edge-TTS/Pexels; waiting pausa la etapa.
PAID_COST_CAP_USD_PER_RUN=0
PAID_COST_CAP_USD_PER_DAY=0
PAID_ON_CAP=zero
