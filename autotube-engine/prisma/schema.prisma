generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum VideoStatus {
  QUEUED
  GENERATING_SCRIPT
  SYNTHESIZING_AUDIO
  COLLECTING_VISUALS
  RENDERING_VIDEO
  WAITING_FOR_INPUT
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ERROR
}

model Video {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  youtubeVideoId String?     @map("youtube_video_id") @db.VarChar(50)
  title          String      @db.VarChar(255)
  description    String?
  script         String?
  tags           String[]    @default([])
  status         VideoStatus @default(QUEUED)
  errorReason    String?     @map("error_reason") @db.VarChar(50)
  videoUrl       String?     @map("video_url")
  runDir         String?     @map("run_dir")
  hookType       String?     @map("hook_type") @db.VarChar(40)
  embedding      Unsupported("vector")?
  templateId     String?     @map("template_id") @db.Uuid
  characterId    String?     @map("character_id") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt    DateTime?   @map("published_at") @db.Timestamptz(6)
  reviewedBy     String?     @map("reviewed_by") @db.VarChar(100)
  reviewedAt     DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes    String?     @map("review_notes")

  template WorkflowTemplate? @relation(fields: [templateId], references: [id])
  logs     VideoLog[]
  assets   VideoAsset[]
  metrics  VideoMetric[]

  @@map("videos")
}

model WorkflowTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(120)
  graphJson Json     @map("graph_json")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  videos    Video[]

  @@map("workflow_templates")
}

model VideoLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId     String   @map("video_id") @db.Uuid
  stage       String   @db.VarChar(30)
  nodeId      String?  @map("node_id") @db.VarChar(64)
  provider    String?  @db.VarChar(50)
  attempt     Int      @default(1)
  success     Boolean
  costUsd     Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  errorDetail String?  @map("error_detail")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_logs")
}

model VideoAsset {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId       String   @map("video_id") @db.Uuid
  assetType     String   @map("asset_type") @db.VarChar(20)
  source        String   @db.VarChar(50)
  sourceAssetId String?  @map("source_asset_id") @db.VarChar(255)
  licenseType   String?  @map("license_type") @db.VarChar(100)
  licenseUrl    String?  @map("license_url")
  subjectId     String?  @map("subject_id") @db.VarChar(64)
  outfitId      String?  @map("outfit_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_assets")
}

model VideoMetric {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId           String   @map("video_id") @db.Uuid
  views             Int      @default(0)
  likes             Int      @default(0)
  comments          Int      @default(0)
  retentionRate     Float    @default(0) @map("retention_rate")
  estimatedRevenue  Decimal  @default(0) @map("estimated_revenue") @db.Decimal(10, 4)
  fetchedAt         DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  video             Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_metrics")
}
